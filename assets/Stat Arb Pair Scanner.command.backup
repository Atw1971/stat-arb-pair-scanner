#!/bin/zsh

set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_DIR"

if ! /usr/bin/curl -s "http://127.0.0.1:8510" >/dev/null 2>&1; then
  if [[ -x "$PROJECT_DIR/.venv/bin/streamlit" ]]; then
    STREAMLIT_BIN="$PROJECT_DIR/.venv/bin/streamlit"
  else
    STREAMLIT_BIN="$(command -v streamlit)"
  fi

  "$STREAMLIT_BIN" run app.py \
    --server.port 8510 \
    --server.address 127.0.0.1 \
    --server.fileWatcherType none \
    --server.headless true >/tmp/stat-arb-pair-scanner.log 2>&1 &
  sleep 3
fi

/usr/bin/open -a "Google Chrome" "http://127.0.0.1:8510" 2>/dev/null \
  || /usr/bin/open -a "Safari" "http://127.0.0.1:8510" 2>/dev/null \
  || /usr/bin/open "http://127.0.0.1:8510"
